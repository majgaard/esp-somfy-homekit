Screen {
    background: #0c1421;
    color: #dde7f0;
}
Header { background: #16283a; }
Footer { background: #16283a; }
#workspace { padding: 1 2; }
#connection { height: auto; margin-bottom: 1; }
#port { width: 1fr; margin-right: 1; }
#connection Button { margin-left: 1; }
#overview { height: auto; background: #16283a; color: #7fe1c3; padding: 0 1; }
#notice { height: auto; min-height: 2; padding: 0 1; margin-top: 1; color: #bdcddd; }
TabbedContent { height: 1fr; }
TabPane { padding: 1 2; }
.eyebrow { color: #7fe1c3; text-style: bold; height: auto; }
.intro { height: auto; margin-bottom: 1; }
.hint { height: auto; color: #9eafc2; margin: 1 0; }
.section-title { height: auto; text-style: bold; margin: 1 0; color: #7fe1c3; }
#shades { height: 6; margin-bottom: 1; }
#shade { margin-bottom: 1; }
.buttons { height: auto; min-height: 3; margin: 0 0 1 0; }
.buttons Button { margin-right: 1; }
#target { width: 12; margin-right: 1; }
Button { min-width: 12; }
Button.-primary { background: #246852; color: #f2fff9; }
Input { margin-bottom: 1; }
Label { height: auto; margin-bottom: 1; }
#network-tab Input { max-width: 65; }
#network-tab Button { margin-bottom: 1; }
#activity { height: 1fr; border: round #28465e; background: #0a111d; }
Confirm, PairScreen, ConfigScreen { align: center middle; background: #050a12 75%; }
.dialog { width: 78; height: auto; max-height: 90%; border: round #4fae95; background: #122132; padding: 1 3; }
.dialog-title { text-style: bold; color: #7fe1c3; margin: 0 0 1 0; }
.dialog Static { height: auto; margin-bottom: 1; }
.config-dialog { width: 88; }
#names { height: 6; margin-bottom: 1; }
#update-shades { margin-bottom: 1; }
#settings-shade { margin-bottom: 1; }
.field-row { height: auto; }
.field-row Input { width: 1fr; margin-right: 1; }
.switch-row { height: auto; min-height: 3; }
.switch-row Label { width: 1fr; padding-top: 1; }
.switch-row Switch { margin-right: 1; }
#config-error { color: #ffac9d; }
.compact #workspace { padding: 0 1; }
.compact TabPane { padding: 1 0; }
.compact .buttons { layout: grid; grid-size: 2; grid-gutter: 1; height: auto; }
.compact .buttons Button { width: 1fr; }
.compact .dialog { width: 95%; padding: 1 2; }
